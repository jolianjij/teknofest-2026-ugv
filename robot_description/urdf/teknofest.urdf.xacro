<?xml version="1.0"?>
<robot name="teknofest_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==========================================================
       DIMENSIONS (all meters/kg/rad unless noted)
       chassis_length/chassis_height/track_separation/track_width below
       reflect a REAL measurement (2026-09-11, user-provided): overall
       robot 149cm long x 110cm wide, symmetric about center (confirmed:
       half-width = 55cm). Only the total envelope was measured, not the
       internal hull-vs-track breakdown, so chassis_width and chassis_mass
       are still guesses (scaled proportionally from the old placeholder
       ratio) - fine for visual/RViz purposes, but the numbers Nav2's
       obstacle-avoidance footprint actually depends on
       (nav2_params.yaml/nav2_params_hardware.yaml's footprint polygon,
       already updated to match this same 149x110 measurement) are the
       real ones now, not a guess.
       ========================================================== -->
  <xacro:property name="chassis_length" value="1.49"/>
  <xacro:property name="chassis_width"  value="0.65"/>   <!-- hull only, STILL a guess - tracks stick out to the full 1.10m measured width -->
  <xacro:property name="chassis_height" value="0.15"/>   <!-- not measured, unchanged placeholder -->
  <xacro:property name="chassis_mass"   value="8.0"/>    <!-- not measured, unchanged placeholder -->

  <xacro:property name="track_length"     value="1.49"/>
  <xacro:property name="track_width"      value="0.09"/> <!-- not measured, unchanged placeholder -->
  <xacro:property name="track_height"     value="0.12"/> <!-- not measured, unchanged placeholder -->
  <xacro:property name="track_separation" value="1.01"/> <!-- = measured total width (1.10) - track_width, the critical number for turning kinematics -->
  <xacro:property name="track_mass"       value="1.5"/>
  <xacro:property name="ground_clearance" value="0.03"/>
  <xacro:property name="sim_wheel_radius" value="0.05"/> <!-- sim-only drive-wheel proxy, see Tracks section below -->

  <!-- sensor mount offsets, relative to base_link origin (chassis center, at ground_clearance height) -->
  <xacro:property name="lidar_xyz"  value="0.10 0 ${chassis_height + 0.02}"/>
  <xacro:property name="imu_xyz"    value="0 0 ${chassis_height/2}"/>       <!-- BNO055 inside ESP32 enclosure -->
  <xacro:property name="cam_front_xyz" value="${chassis_length/2} 0 ${chassis_height*0.7}"/>
  <xacro:property name="cam_rear_xyz"  value="-${chassis_length/2} 0 ${chassis_height*0.7}"/>
  <xacro:property name="cam_rear_rpy"  value="0 0 3.14159"/>                <!-- facing backward -->

  <!-- aim pan/tilt mount base, relative to base_link -->
  <xacro:property name="aim_mount_xyz" value="0.05 0 ${chassis_height + 0.03}"/>
  <!-- servo mechanical range - matches SERVO_MIN_US/MAX_US in esp32_firmware/config.h (500-2500us -> ~180deg).
       Update if the physical servo horn / linkage doesn't actually swing the full range. -->
  <xacro:property name="pan_limit"  value="1.5708"/>  <!-- +-90 deg -->
  <xacro:property name="tilt_limit" value="0.7854"/>  <!-- +-45 deg, tilt usually needs less range than pan -->

  <material name="hull_dark">
    <color rgba="0.15 0.15 0.17 1.0"/>
  </material>
  <material name="track_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="sensor_grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- ==========================================================
       base_footprint: ground-projected origin, REP-120 convention.
       Nav2 costmaps/localization expect this as the robot's
       planar reference frame; base_link sits above it.
       ========================================================== -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${ground_clearance + track_height/2}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="hull_dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.10" ixy="0" ixz="0" iyy="0.15" iyz="0" izz="0.20"/>
    </inertial>
  </link>

  <!-- ==========================================================
       Tracks - one box per side, FIXED to the chassis. Tank drive's
       turning kinematics are skid-steer (identical math to diff drive:
       left/right speed -> linear.x + angular.z), so the track's visual
       shape never needs to rotate for Nav2, TF, or real hardware to
       work - it's a static box, same as the real track housing.

       A previous version made this joint `continuous` so Gazebo's
       DiffDrive plugin (below) had something to spin - but DiffDrive
       spins its target joint like a WHEEL, and a box spinning about an
       axis tumbles/cartwheels instead of rolling, which looked exactly
       as broken as it sounds. Fixed here by giving DiffDrive a separate,
       small cylindrical "drive_wheel" link per side to actually spin
       (see below) while the track box itself stays visually static,
       matching a real tank track.
       ========================================================== -->
  <xacro:macro name="track" params="side y_sign">
    <link name="${side}_track">
      <visual>
        <geometry>
          <box size="${track_length} ${track_width} ${track_height}"/>
        </geometry>
        <material name="track_black"/>
      </visual>
      <collision>
        <geometry>
          <box size="${track_length} ${track_width} ${track_height}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${track_mass}"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
      </inertial>
    </link>

    <joint name="${side}_track_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${side}_track"/>
      <origin xyz="0 ${y_sign} 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:track side="left"  y_sign="${track_separation/2}"/>
  <xacro:track side="right" y_sign="-${track_separation/2}"/>

  <!-- ==========================================================
       Drive wheels - sim-only proxies DiffDrive actually spins. Small
       and thin so they sit inside the track box's footprint and are
       barely visible; they're what makes the physics/odometry work,
       not a real component on the physical robot.
       ========================================================== -->
  <xacro:macro name="drive_wheel" params="side y_sign">
    <link name="${side}_drive_wheel">
      <visual>
        <geometry><cylinder radius="${sim_wheel_radius}" length="0.04"/></geometry>
        <material name="track_black"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${sim_wheel_radius}" length="0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
      </inertial>
    </link>

    <!-- z offset drops the wheel so its bottom edge touches the ground
         (z=0): base_link itself sits at ground_clearance+track_height/2
         above ground, so the wheel center needs to be that far below
         base_link, plus its own radius back up. Without this the wheel
         floats in mid-air, spins, and grips nothing - exactly what was
         happening before this fix (robot didn't move at all). -->
    <joint name="${side}_drive_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_drive_wheel"/>
      <origin xyz="0 ${y_sign} ${sim_wheel_radius - ground_clearance - track_height/2}" rpy="1.5707963 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left"  y_sign="${track_separation/2}"/>
  <xacro:drive_wheel side="right" y_sign="-${track_separation/2}"/>

  <!-- ==========================================================
       Lidar
       ========================================================== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.038" length="0.05"/></geometry>
      <material name="sensor_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.038" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.19"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_xyz}" rpy="0 0 0"/>
  </joint>

  <!-- ==========================================================
       IMU (BNO055, inside the ESP32 enclosure)
       ========================================================== -->
  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_xyz}" rpy="0 0 0"/>
  </joint>

  <!-- ==========================================================
       Camera macro: body-frame link (ROS convention, X-forward)
       plus a child *_optical_frame link (Z-forward/X-right/Y-down,
       REP-103) - vision/segmentation nodes should publish against
       the optical frame, not the body frame.
       ========================================================== -->
  <xacro:macro name="camera" params="name xyz rpy:='0 0 0' parent:='base_link'">
    <link name="camera_${name}_link">
      <visual>
        <geometry><box size="0.03 0.05 0.03"/></geometry>
        <material name="sensor_grey"/>
      </visual>
      <collision>
        <geometry><box size="0.03 0.05 0.03"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="camera_${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="camera_${name}_optical_frame"/>

    <joint name="camera_${name}_optical_joint" type="fixed">
      <parent link="camera_${name}_link"/>
      <child link="camera_${name}_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
    </joint>
  </xacro:macro>

  <xacro:camera name="front" xyz="${cam_front_xyz}"/>
  <xacro:camera name="rear"  xyz="${cam_rear_xyz}" rpy="${cam_rear_rpy}"/>

  <!-- ==========================================================
       Aim camera - NOT a fixed mount, it rides the pan/tilt servo
       pair (PCA9685 ch6/ch7, driven by FlySky VarA/VarB - see
       esp32_firmware/PINOUT.md). Real joint states for these only
       exist once something publishes them from the actual servo
       commands (not wired up yet) - until then RViz/joint_state_publisher
       will just show them at their default/center position.
       ========================================================== -->
  <link name="aim_pan_base"/>

  <joint name="aim_pan_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="aim_pan_base"/>
    <origin xyz="${aim_mount_xyz}" rpy="0 0 0"/>
  </joint>

  <link name="aim_pan_link">
    <visual>
      <geometry><cylinder radius="0.015" length="0.02"/></geometry>
      <material name="sensor_grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.015" length="0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
    </inertial>
  </link>

  <joint name="aim_pan_joint" type="revolute">
    <parent link="aim_pan_base"/>
    <child link="aim_pan_link"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pan_limit}" upper="${pan_limit}" effort="1.0" velocity="3.0"/>
  </joint>

  <link name="aim_tilt_link">
    <visual>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
      <material name="sensor_grey"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
    </inertial>
  </link>

  <joint name="aim_tilt_joint" type="revolute">
    <parent link="aim_pan_link"/>
    <child link="aim_tilt_link"/>
    <origin xyz="0 0 0.015" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-tilt_limit}" upper="${tilt_limit}" effort="1.0" velocity="3.0"/>
  </joint>

  <xacro:camera name="aim" xyz="0 0 0.02" parent="aim_tilt_link"/>

  <!-- ==========================================================
       Gazebo Harmonic simulation plugins (ROS 2 Jazzy's paired sim).
       Sensors publish on native GZ transport topics - a ros_gz_bridge
       config (see robot_description/config/gz_bridge.yaml) maps them
       to ROS 2 topics with the SAME names the real robot uses
       (/scan, /esp32/imu, /front/image_raw, ...) so Nav2/vision nodes
       don't need to know sim vs real.

       Drivetrain uses Gazebo's native DiffDrive system plugin (not
       ros2_control) because that's what keeps the ROS-facing interface
       identical to real hardware: it takes /cmd_vel and publishes
       odometry, exactly like the ESP32 already does over the serial
       bridge. Skid-steer and diff-drive share the same kinematics, so
       track_separation plugs in directly as the wheel separation.
       wheel_radius is a PLACEHOLDER (no real "wheel" on a track) -
       tune it against real robot speed once track_separation etc.
       are measured; it only affects the cmd_vel-to-wheel-speed scaling.
       ========================================================== -->

  <gazebo reference="lidar_link">
    <sensor name="rplidar_c1" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="bno055" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <topic>esp32/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <xacro:macro name="gz_camera" params="name update_rate:=30">
    <gazebo reference="camera_${name}_link">
      <sensor name="camera_${name}" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <topic>${name}/image_raw</topic>
        <gz_frame_id>camera_${name}_optical_frame</gz_frame_id>
        <update_rate>${update_rate}</update_rate>
        <camera>
          <horizontal_fov>1.089</horizontal_fov> <!-- ~62deg placeholder, front/rear differ in real FOV (C30 106 deg, C50 76 deg) - tune per camera once mounted -->
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>50</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:gz_camera name="front"/>
  <xacro:gz_camera name="rear"/>
  <xacro:gz_camera name="aim" update_rate="30"/>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_drive_wheel_joint</left_joint>
      <right_joint>right_drive_wheel_joint</right_joint>
      <wheel_separation>${track_separation}</wheel_separation>
      <wheel_radius>${sim_wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

</robot>
