<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>teknofest_description</name>
  <version>0.0.1</version>
  <description>URDF/xacro description of the tank-drive obstacle course robot</description>
  <maintainer email="147213250+jolianjij@users.noreply.github.com">jolianjij</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Gazebo sim (sim.launch.py, nav2_sim.launch.py) - these were already
       used by nav2_sim.launch.py but never declared here. -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <!-- Nav2 + EKF, both sim and hardware variants (nav2_sim.launch.py /
       nav2_hardware.launch.py) -->
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>

  <!-- Real-hardware odometry only (nav2_hardware.launch.py) - no map/wheel
       encoders, see that file's own docstring. Not needed for sim. -->
  <exec_depend>rf2o_laser_odometry</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
